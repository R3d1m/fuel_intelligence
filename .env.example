# Simulator Connection
SIMULATOR_BASE_URL=http://localhost:8000
SIMULATOR_TIMEOUT_SECONDS=5.0
SIMULATOR_MAX_RETRIES=3
SIMULATOR_BACKOFF_FACTOR=0.5

# Ingest / Poller
POLL_INTERVAL_SECONDS=1.0

# Resilience / Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=10.0

# App Settings
APP_ENV=development
LOG_LEVEL=INFO
PORT=8001
